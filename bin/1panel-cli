#!/usr/bin/env python3
"""1panel-cli 启动器:定位 panel_cli 包并执行主入口。"""

import os
import sys

_HERE = os.path.dirname(os.path.realpath(__file__))
_ROOT = os.path.dirname(_HERE)
for candidate in (_ROOT, _HERE):
    if os.path.isdir(os.path.join(candidate, "panel_cli")):
        if candidate not in sys.path:
            sys.path.insert(0, candidate)
        break

from panel_cli.main import main  # noqa: E402

if __name__ == "__main__":
    sys.exit(main())
