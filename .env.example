# 1Panel 面板账号信息配置示例
# 复制本文件为 .env 并填入真实值,或者通过环境变量 / CLI 参数提供

# 面板地址(可包含安全入口路径,如 http://10.0.0.1:41394/abcdef1234)
PANEL_URL=http://10.0.0.1:41394

# 面板安全入口(也可从 PANEL_URL 的路径中自动识别,未启用安全入口可留空)
PANEL_ENTRANCE=abcdef1234

# 面板用户名与密码
PANEL_USERNAME=admin
PANEL_PASSWORD=changeme

# 登录语言(可选,默认 zh)
# PANEL_LANGUAGE=zh

# 多节点面板的目标节点标识(可选,默认 local;也可使用全局参数 --node)
# PANEL_NODE=local

# 开启 MFA 时需要提供的动态验证码(可选)
# PANEL_MFA_CODE=123456

# 面板要求验证码时提供的答案(可选,交互式登录会提示输入)
# PANEL_CAPTCHA=8

# 面板为 HTTPS 且使用自签名证书时设置为 true
# PANEL_INSECURE=false

# 面板所在 Linux 主机的 SSH 用户名与密码(可选)
# login 时自动写入面板「设置 → 终端 → SSH 本地连接」,exec 执行时自动对齐:
# exec 默认以该用户执行(不接触 root),需要 root 权限的命令加 --sudo(需免密 sudo)
# LINUX_SSH_USER=ubuntu
# LINUX_SSH_PWD=changeme
